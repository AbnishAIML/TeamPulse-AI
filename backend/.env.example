PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/teampulse_db
JWT_SECRET=teampulse_ai_super_secret_jwt_key_2026
JWT_EXPIRES_IN=15m
REFRESH_SECRET=teampulse_ai_refresh_secret_key_2026
REFRESH_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_TIMEOUT_MS=3500
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain,application/zip
# SMTP Configuration (Optional: fallback logs invite/recovery links to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@teampulse.ai
# Cloudinary Configuration (Optional if STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
